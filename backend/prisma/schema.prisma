generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminLog {
  id          Int      @id @default(autoincrement())
  adminId     Int
  action      String   @db.VarChar(50)
  targetType  String   @db.VarChar(50)
  targetId    Int?
  targetName  String?  @db.VarChar(255)
  description String   @db.Text
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  ipAddress   String?  @db.VarChar(50)
  userAgent   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
  @@index([targetId])
  @@index([targetType])
  @@map("admin_logs")
}

model Block {
  id         Int      @id @default(autoincrement())
  blockerId  Int
  blockedId  Int
  createdAt DateTime @default(now())
  blocked    User     @relation("Block_blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker    User     @relation("Block_blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}
model CommentLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  commentId Int
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}
model Comment {
  id            Int           @id @default(autoincrement())
  postId        Int
  userId        Int
  content       String        @db.Text
  parentId      Int?
  replyToUserId Int?
  likeCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  commentLikes  CommentLike[]
  replies       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parent        Comment[]     @relation("CommentReplies")
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([createdAt])
  @@index([parentId])
  @@index([postId])
  @@index([userId])
  @@map("comments")
}
model Conversation {
  id        Int       @id @default(autoincrement())
  userId1   Int
  userId2   Int
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
  @@unique([userId1, userId2])
  @@map("conversations")
}
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@index([postId])
  @@map("favorites")
}
model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("Follow_follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Follow_following", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}
model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String       @db.Text
  readAt         DateTime?
  recalled       Boolean      @default(false)
  recalledAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(50)
  actorId   Int
  entityId  Int
  entityType String  @db.VarChar(50)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  actor     User     @relation("Notification_actor", fields: [actorId], references: [id], onDelete: Cascade)
  user      User     @relation("Notification_user", fields: [userId], references: [id], onDelete: Cascade)
  @@index([actorId], map: "notifications_actorId_fkey")
    @@index([userId, createdAt])
  @@index([userId, isRead])
    @@index([userId, type])
    @@map("notifications")
}
model Post {
  id            Int       @id @default(autoincrement())
  userId        Int
  content       String      @db.Text
  images        String      @db.Text
  address       String?   @db.VarChar(255)
  latitude      Float?
  longitude     Float?
  likeCount     Int       @default(0)
  favoriteCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isPrivate     Boolean   @default(false)
  commentCount  Int       @default(0)
  comments      Comment[]
  favorites     Favorite[]
  likes         Like[]
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([commentCount])
    @@index([createdAt])
    @@index([favoriteCount])
    @@index([likeCount])
    @@index([userId])
    @@map("posts")
}
model Report {
  id             Int       @id @default(autoincrement())
  reporterId     Int
  reportedId     Int
  type           String    @db.VarChar(50)
  description    String?   @db.Text
  images         String?   @db.Text
  chatRecords    String?   @db.Text
  status         String    @default("pending") @db.VarChar(20)
  adminNote      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewerId     Int?
  reviewedAt     DateTime?
  reviewerNote   String?   @db.Text
  adminId        Int?
  adminAt        DateTime?
  admin          User?     @relation("Report_admin", fields: [adminId], references: [id])
  reported       User      @relation("Report_reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reporter       User      @relation("Report_reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer       User?     @relation("Report_reviewer", fields: [reviewerId], references: [id])
  @@index([adminId])
    @@index([createdAt])
    @@index([reportedId])
    @@index([reporterId])
    @@index([reviewerId])
    @@index([status])
    @@map("reports")
}
model User {
  id                Int            @id @default(autoincrement())
  username          String         @unique @db.VarChar(50)
  email             String         @unique @db.VarChar(100)
  password          String         @db.VarChar(255)
  avatar            String?        @db.VarChar(500)
  avatarData        String?        @db.LongText
  bio               String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  allowMessage      Boolean        @default(true)
  followOnlyMessage Boolean        @default(false)
  isActive          Boolean        @default(true)
  role              String         @default("user") @db.VarChar(20)
  wechatOpenId      String?        @unique @db.VarChar(100)
  wechatUnionId     String?        @unique @db.VarChar(100)
  adminLogs         AdminLog[]
  blockedBy         Block[]        @relation("Block_blocked")
  blocking          Block[]        @relation("Block_blocker")
  commentLikes      CommentLike[]
  comments          Comment[]
  favorites         Favorite[]
  followers         Follow[]       @relation("Follow_follower")
  following         Follow[]       @relation("Follow_following")
  likes             Like[]
  notifications     Notification[] @relation("Notification_user")
  notificationsAsActor Notification[] @relation("Notification_actor")
  posts             Post[]
  reportsAsAdmin    Report[]       @relation("Report_admin")
  reportsAsReported Report[]       @relation("Report_reported")
  reportsAsReporter Report[]       @relation("Report_reporter")
  reportsAsReviewer Report[]       @relation("Report_reviewer")
  @@map("users")
}
