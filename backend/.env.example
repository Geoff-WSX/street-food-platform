# 数据库配置（PostgreSQL - Neon）
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/street_food_web?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/street_food_web?sslmode=require"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# 服务器配置
PORT=3000
NODE_ENV="development"

# 跨域配置（生产环境设置具体域名）
CORS_ALLOWED_ORIGINS="https://your-app.vercel.app"

# OpenAI API 配置
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai-proxy.org/v1"

# 七牛云存储配置
QINIU_ACCESS_KEY="your-qiniu-access-key"
QINIU_SECRET_KEY="your-qiniu-secret-key"
QINIU_BUCKET="your-bucket-name"
QINIU_DOMAIN="http://your-cdn-domain.clouddn.com"