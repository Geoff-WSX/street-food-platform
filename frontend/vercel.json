{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": ["sin1"],
  "env": {
    "VITE_API_BASE_URL": {
      "description": "后端 API 地址（填入你的阿里云服务器域名或 IP + /api）",
      "value": "https://your-backend-domain.com/api"
    }
  }
}
